# 🐬 MySQL Configuration
MYSQL_ROOT_PASSWORD=your_root_password

# 🔐 Common Database User (used by all services)
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=mysql
DB_PORT=3306

# 📘 User Service Database
USER_DB_NAME=your_user_db_name
USER_DATABASE_URL=mysql+mysqlconnector://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${USER_DB_NAME}

# 📚 Book Service Database
BOOK_DB_NAME=your_book_db_name
BOOK_DATABASE_URL=mysql+mysqlconnector://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${BOOK_DB_NAME}

# 📖 Borrowing Service Database
BORROWING_DB_NAME=your_borrowing_db_name
BORROWING_DATABASE_URL=mysql+mysqlconnector://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${BORROWING_DB_NAME}

# 🔑 JWT / Auth Settings (used by User Service)
SECRET_KEY=your_secret_key
ALGORITHM=your_algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_SECRET_KEY=your_jwt_secret_key
