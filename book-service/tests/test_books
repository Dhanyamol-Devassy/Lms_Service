import pytest
from fastapi.testclient import TestClient
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker
from app.main import app
from app.database import Base, get_db

# Use an in-memory SQLite database for testing
SQLALCHEMY_DATABASE_URL = "sqlite://"
engine = create_engine(SQLALCHEMY_DATABASE_URL, connect_args={"check_same_thread": False})
TestingSessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)

# Override the get_db dependency
def override_get_db():
    db = TestingSessionLocal()
    try:
        yield db
    finally:
        db.close()

app.dependency_overrides[get_db] = override_get_db
client = TestClient(app)

@pytest.fixture(autouse=True)
def setup_database():
    Base.metadata.drop_all(bind=engine)
    Base.metadata.create_all(bind=engine)

def test_add_book():
    response = client.post(
        "/books/",
        json={"title": "Book 1", "author": "Author A", "isbn": "111", "available": True},
        headers={"Authorization": "Bearer fake_token"}  # mock role in test dependency if needed
    )
    assert response.status_code == 200
    assert response.json()["title"] == "Book 1"

def test_get_books():
    test_add_book()
    response = client.get("/books/", headers={"Authorization": "Bearer fake_token"})
    assert response.status_code == 200
    assert isinstance(response.json(), list)

def test_get_book_by_id():
    book = client.post("/books/", json={"title": "Book 2", "author": "Author B", "isbn": "222", "available": True},
                       headers={"Authorization": "Bearer fake_token"}).json()
    response = client.get(f"/books/{book['id']}", headers={"Authorization": "Bearer fake_token"})
    assert response.status_code == 200
    assert response.json()["id"] == book["id"]

def test_update_book():
    book = client.post("/books/", json={"title": "Old", "author": "X", "isbn": "333", "available": True},
                       headers={"Authorization": "Bearer fake_token"}).json()
    response = client.put(f"/books/{book['id']}", json={"title": "Updated"},
                          headers={"Authorization": "Bearer fake_token"})
    assert response.status_code == 200
    assert response.json()["title"] == "Updated"

def test_delete_book():
    book = client.post("/books/", json={"title": "Delete", "author": "Y", "isbn": "444", "available": True},
                       headers={"Authorization": "Bearer fake_token"}).json()
    response = client.delete(f"/books/{book['id']}", headers={"Authorization": "Bearer fake_token"})
    assert response.status_code == 200
    assert response.json()["message"] == "Book deleted successfully"

def test_update_book_availability():
    book = client.post("/books/", json={"title": "Borrow", "author": "Z", "isbn": "555", "available": True},
                       headers={"Authorization": "Bearer fake_token"}).json()
    response = client.put(f"/books/borrow/{book['id']}?available=false", headers={"Authorization": "Bearer fake_token"})
    assert response.status_code == 200
    assert response.json()["message"] == "Book availability updated"
